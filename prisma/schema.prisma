generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  role          String        @default("STUDENT")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  age           Int?
  education     String?       @default("")
  isOnboarded   Boolean       @default(false)
  phone         String?       @default("")
  accounts      Account[]
  requests      JoinRequest[]
  sessions      Session[]
  student       Student?
  trainer       Trainer?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model JoinRequest {
  id        String   @id @default(cuid())
  userId    String
  type      String
  targetId  String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trainer {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  specialization String
  bio            String   @default("")
  avatar         String   @default("")
  rating         Float    @default(0)
  experience     String   @default("")
  userId         String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  courses        Course[]
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id               String        @id @default(cuid())
  title            String
  description      String        @default("")
  shortDescription String        @default("")
  logo             String        @default("")
  price            Float
  discountPrice    Float?
  category         String        @default("General")
  level            String        @default("Beginner")
  duration         String        @default("0 hours")
  lessonsCount     Int           @default(0)
  studentsEnrolled Int           @default(0)
  rating           Float         @default(0)
  tags             String        @default("[]")
  syllabus         String        @default("[]")
  isPublished      Boolean       @default(false)
  trainerId        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  certificates     Certificate[]
  trainer          Trainer       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  modules          Module[]
  quizzes          Quiz[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  order       Int      @default(0)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes     Quiz[]
}

model Lesson {
  id              String               @id @default(cuid())
  title           String
  description     String               @default("")
  videoUrl        String               @default("")
  notes           String               @default("")
  resources       String               @default("[]")
  order           Int                  @default(0)
  duration        String               @default("")
  isFree          Boolean              @default(false)
  moduleId        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  problems        CodingProblem[]
  module          Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignments     LessonAssignment[]
  files           LessonFile[]
  lessonNotes     LessonNote[]
  practiceFiles   LessonPracticeFile[]
  progresses      LessonProgress[]
  lessonResources LessonResource[]
}

model LessonFile {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  secureUrl   String
  publicId    String   @unique
  fileType    String
  mimeType    String   @default("")
  fileSize    Int      @default(0)
  lessonId    String?
  courseId    String   @default("")
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lesson      Lesson?  @relation(fields: [lessonId], references: [id])
}

model LessonNote {
  id               String       @id @default(cuid())
  title            String
  description      String       @default("")
  category         String       @default("Theory")
  visibility       String       @default("Public")
  studentAccess    String       @default("Everyone")
  secureUrl        String
  publicId         String       @unique
  fileType         String
  mimeType         String       @default("")
  fileSize         Int          @default(0)
  version          Int          @default(1)
  parentId         String?
  downloadCount    Int          @default(0)
  lastDownloadedAt DateTime?
  uploadedBy       String       @default("Admin")
  lessonId         String
  courseId         String       @default("")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  lesson           Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parent           LessonNote?  @relation("NoteVersions", fields: [parentId], references: [id])
  versions         LessonNote[] @relation("NoteVersions")
}

model LessonResource {
  id          String   @id @default(cuid())
  title       String
  url         String
  type        String   @default("Link")
  description String   @default("")
  lessonId    String
  courseId    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonAssignment {
  id           String    @id @default(cuid())
  title        String
  description  String    @default("")
  instructions String    @default("")
  deadline     DateTime?
  maxMarks     Int       @default(100)
  secureUrl    String    @default("")
  publicId     String    @default("")
  fileType     String    @default("")
  mimeType     String    @default("")
  fileSize     Int       @default(0)
  lessonId     String
  courseId     String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonPracticeFile {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  type        String   @default("Starter Code")
  secureUrl   String
  publicId    String   @unique
  fileType    String
  mimeType    String   @default("")
  fileSize    Int      @default(0)
  lessonId    String
  courseId    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Student {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  avatar            String              @default("")
  userId            String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  certificates      Certificate[]
  codingSubmissions CodingSubmission[]
  courseProgresses  CourseProgress[]
  enrollments       Enrollment[]
  lessonProgresses  LessonProgress[]
  quizAttempts      QuizAttempt[]
  retakeRequests    QuizRetakeRequest[]
  user              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  queries           StudentQuery[]
}

model Enrollment {
  id            String   @id @default(cuid())
  studentId     String
  courseId      String
  paymentStatus String   @default("pending")
  progress      Int      @default(0)
  enrolledAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  studentId   String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model CourseProgress {
  id               String    @id @default(cuid())
  studentId        String
  courseId         String
  completedLessons Int       @default(0)
  totalLessons     Int       @default(0)
  percentage       Float     @default(0)
  lastLessonId     String    @default("")
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model CodingProblem {
  id           String             @id @default(cuid())
  title        String
  difficulty   String             @default("Easy")
  description  String             @default("")
  inputFormat  String             @default("")
  outputFormat String             @default("")
  constraints  String             @default("")
  examples     String             @default("[]")
  hiddenTests  String             @default("[]")
  visibleTests String             @default("[]")
  starterCode  String             @default("{}")
  languages    String             @default("[]")
  timeLimit    Int                @default(2)
  memoryLimit  Int                @default(256)
  points       Int                @default(10)
  lessonId     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lesson       Lesson?            @relation(fields: [lessonId], references: [id])
  submissions  CodingSubmission[]
}

model CodingSubmission {
  id          String        @id @default(cuid())
  studentId   String
  problemId   String
  language    String        @default("python")
  code        String        @default("")
  status      String        @default("pending")
  output      String        @default("")
  timeTaken   Float         @default(0)
  memoryUsed  Float         @default(0)
  passedTests Int           @default(0)
  totalTests  Int           @default(0)
  submittedAt DateTime      @default(now())
  problem     CodingProblem @relation(fields: [problemId], references: [id])
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Quiz {
  id                String              @id @default(cuid())
  title             String
  description       String              @default("")
  courseId          String?
  moduleId          String?
  timeLimit         Int                 @default(0)
  passMark          Int                 @default(70)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  afterLessonId     String?
  isFinalAssessment Boolean             @default(false)
  isPublished       Boolean             @default(true)
  course            Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module            Module?             @relation(fields: [moduleId], references: [id])
  attempts          QuizAttempt[]
  questions         QuizQuestion[]
  retakeRequests    QuizRetakeRequest[]
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  question      String
  type          String   @default("mcq")
  options       String   @default("[]")
  correctAnswer String   @default("")
  explanation   String   @default("")
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  studentId   String
  quizId      String
  answers     String   @default("{}")
  score       Int      @default(0)
  totalMarks  Int      @default(0)
  percentage  Float    @default(0)
  passed      Boolean  @default(false)
  timeTaken   Int      @default(0)
  completedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model QuizRetakeRequest {
  id          String    @id @default(cuid())
  studentId   String
  quizId      String
  status      String    @default("PENDING")
  resolvedBy  String?
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Certificate {
  id            String   @id @default(cuid())
  studentId     String
  courseId      String
  certificateId String   @unique @default(cuid())
  issuedAt      DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentQuery {
  id         String   @id @default(cuid())
  studentId  String
  subject    String
  message    String
  status     String   @default("OPEN")
  adminReply String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Developer {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String   @default("")
  avatar    String   @default("")
  github    String   @default("")
  linkedin  String   @default("")
  resume    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id             String    @id @default(cuid())
  recipientEmail String
  recipientName  String?
  userId         String?
  studentId      String?
  type           String
  title          String
  subject        String
  message        String
  htmlContent    String?
  metadata       String?
  status         String    @default("PENDING")
  error          String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([recipientEmail])
  @@index([type])
  @@index([status])
}
