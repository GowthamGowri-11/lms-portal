generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== NextAuth & Auth.js =====
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("GUEST") // GUEST, STUDENT, TRAINER, ADMIN
  phone         String?   @default("")
  age           Int?
  education     String?   @default("") // School Student | Undergraduate | Postgraduate | Professional | Trainer
  isOnboarded   Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  requests      JoinRequest[]
  student       Student?
  trainer       Trainer?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===== Join Requests (For Students and Trainers) =====
model JoinRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "COURSE_ENROLLMENT" | "TRAINER_APPLICATION"
  targetId  String?  // courseId if it's an enrollment
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== Trainers =====
model Trainer {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  specialization String
  bio            String   @default("")
  avatar         String   @default("")
  rating         Float    @default(0)
  experience     String   @default("")
  courses        Course[]
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ===== Courses =====
model Course {
  id               String       @id @default(cuid())
  title            String
  description      String       @default("")
  shortDescription String       @default("")
  logo             String       @default("")
  price            Float
  discountPrice    Float?
  category         String       @default("General")
  level            String       @default("Beginner")
  duration         String       @default("0 hours")
  lessonsCount     Int          @default(0)
  studentsEnrolled Int          @default(0)
  rating           Float        @default(0)
  tags             String       @default("[]")
  syllabus         String       @default("[]")
  isPublished      Boolean      @default(false)
  trainerId        String
  trainer          Trainer      @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  modules          Module[]
  quizzes          Quiz[]
  certificates     Certificate[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// ===== Modules =====
model Module {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  order       Int      @default(0)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  quizzes     Quiz[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Lessons =====
model Lesson {
  id             String               @id @default(cuid())
  title          String
  description    String               @default("")
  videoUrl       String               @default("")
  notes          String               @default("")
  resources      String               @default("[]")
  order          Int                  @default(0)
  duration       String               @default("")
  isFree         Boolean              @default(false)
  moduleId       String
  module         Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses     LessonProgress[]
  problems       CodingProblem[]
  files          LessonFile[]
  lessonNotes    LessonNote[]
  lessonResources LessonResource[]
  assignments    LessonAssignment[]
  practiceFiles  LessonPracticeFile[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

// ===== Lesson Files (Cloudinary uploads) =====
model LessonFile {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  secureUrl   String
  publicId    String   @unique
  fileType    String   // image | video | pdf | docx | pptx | file
  mimeType    String   @default("")
  fileSize    Int      @default(0)
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  courseId    String   @default("")
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Lesson Notes =====
model LessonNote {
  id               String      @id @default(cuid())
  title            String
  description      String      @default("")
  category         String      @default("Theory")   // Theory | Practical | Assignment | Cheat Sheet | Reference | Project
  visibility       String      @default("Public")   // Public | Private | Draft
  studentAccess    String      @default("Everyone") // Everyone | Only Enrolled Students | Only Premium Students
  secureUrl        String
  publicId         String      @unique
  fileType         String      // pdf | pptx | docx | zip | txt | file
  mimeType         String      @default("")
  fileSize         Int         @default(0)
  version          Int         @default(1)
  parentId         String?     // points to the first/root note for version chains
  parent           LessonNote? @relation("NoteVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions         LessonNote[] @relation("NoteVersions")
  downloadCount    Int         @default(0)
  lastDownloadedAt DateTime?
  uploadedBy       String      @default("Admin")
  lessonId         String
  lesson           Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId         String      @default("")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ===== Lesson Resources (External Links) =====
model LessonResource {
  id           String   @id @default(cuid())
  title        String
  url          String
  type         String   @default("Link") // GitHub | Documentation | Official Website | Reference | YouTube | Blog | Article | Research Paper | External URL
  description  String   @default("")
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ===== Lesson Assignments =====
model LessonAssignment {
  id           String    @id @default(cuid())
  title        String
  description  String    @default("")
  instructions String    @default("")
  deadline     DateTime?
  maxMarks     Int       @default(100)
  secureUrl    String    @default("") // PDF attachment (Cloudinary)
  publicId     String    @default("")
  fileType     String    @default("")
  mimeType     String    @default("")
  fileSize     Int       @default(0)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId     String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ===== Lesson Practice Files =====
model LessonPracticeFile {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  type        String   @default("Starter Code") // Starter Code | Completed Code | ZIP Project | Source Code | Sample Project
  secureUrl   String
  publicId    String   @unique
  fileType    String   // zip | file | pdf | etc.
  mimeType    String   @default("")
  fileSize    Int      @default(0)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Students =====
model Student {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  avatar          String           @default("")
  enrollments     Enrollment[]
  lessonProgresses LessonProgress[]
  courseProgresses CourseProgress[]
  codingSubmissions CodingSubmission[]
  quizAttempts    QuizAttempt[]
  retakeRequests  QuizRetakeRequest[]
  certificates    Certificate[]
  queries         StudentQuery[]
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ===== Enrollments =====
model Enrollment {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  paymentStatus String   @default("pending")
  progress      Int      @default(0)
  enrolledAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, courseId])
}

// ===== Lesson Progress =====
model LessonProgress {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, lessonId])
}

// ===== Course Progress =====
model CourseProgress {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId          String
  completedLessons  Int      @default(0)
  totalLessons      Int      @default(0)
  percentage        Float    @default(0)
  lastLessonId      String   @default("")
  isCompleted       Boolean  @default(false)
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([studentId, courseId])
}

// ===== Coding Problems =====
model CodingProblem {
  id            String             @id @default(cuid())
  title         String
  difficulty    String             @default("Easy")
  description   String             @default("")
  inputFormat   String             @default("")
  outputFormat  String             @default("")
  constraints   String             @default("")
  examples      String             @default("[]")
  hiddenTests   String             @default("[]")
  visibleTests  String             @default("[]")
  starterCode   String             @default("{}")
  languages     String             @default("[]")
  timeLimit     Int                @default(2)
  memoryLimit   Int                @default(256)
  points        Int                @default(10)
  lessonId      String?
  lesson        Lesson?            @relation(fields: [lessonId], references: [id])
  submissions   CodingSubmission[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// ===== Coding Submissions =====
model CodingSubmission {
  id           String        @id @default(cuid())
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  problemId    String
  problem      CodingProblem @relation(fields: [problemId], references: [id])
  language     String        @default("python")
  code         String        @default("")
  status       String        @default("pending")
  output       String        @default("")
  timeTaken    Float         @default(0)
  memoryUsed   Float         @default(0)
  passedTests  Int           @default(0)
  totalTests   Int           @default(0)
  submittedAt  DateTime      @default(now())
}

// ===== Quizzes =====
model Quiz {
  id                String        @id @default(cuid())
  title             String
  description       String        @default("")
  courseId          String?
  course            Course?       @relation(fields: [courseId], references: [id])
  moduleId          String?
  module            Module?       @relation(fields: [moduleId], references: [id])
  afterLessonId     String?       // Place quiz dynamically right after this lesson ID
  isFinalAssessment Boolean       @default(false) // If true (or afterLessonId is null and moduleId is null), place at the end of course
  timeLimit         Int           @default(0)
  passMark          Int           @default(70)
  questions         QuizQuestion[]
  attempts          QuizAttempt[]
  retakeRequests    QuizRetakeRequest[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// ===== Quiz Questions =====
model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  type          String   @default("mcq")
  options       String   @default("[]")
  correctAnswer String   @default("")
  explanation   String   @default("")
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

// ===== Quiz Attempts =====
model QuizAttempt {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  answers     String   @default("{}")
  score       Int      @default(0)
  totalMarks  Int      @default(0)
  percentage  Float    @default(0)
  passed      Boolean  @default(false)
  timeTaken   Int      @default(0)
  completedAt DateTime @default(now())
}

// ===== Quiz Retake Requests =====
model QuizRetakeRequest {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  resolvedBy  String?   // userId of admin/trainer who resolved
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
}

// ===== Certificates =====
model Certificate {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  certificateId String   @unique @default(cuid())
  issuedAt      DateTime @default(now())
}

// ===== Developers =====
// ===== Student Queries =====
model StudentQuery {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    String
  message    String
  status     String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  adminReply String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ===== Developers =====
model Developer {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String   @default("")
  avatar    String   @default("")
  github    String   @default("")
  linkedin  String   @default("")
  resume    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
